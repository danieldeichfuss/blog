---
import siteConfig from "@/site.config";

export interface Props {
  meta?: string;
  annotation?: string;
}

const { meta = "thoughts", annotation } = Astro.props;
---

<footer class="border-border mt-12 border-t py-8">
  <div class="app-layout">
    <div class="flex flex-col items-center">
      <span class="mb-3 block text-xl font-semibold tracking-tight">
        {siteConfig.author}<span class="text-primary font-normal">.</span>
      </span>
      <span
        class="font-code text-muted-foreground text-center text-sm leading-relaxed tracking-wide text-balance"
        set:html={meta}
      />
      {
        annotation && (
          <span class="font-annotation text-primary mx-auto mt-6 block max-w-70 -rotate-1 text-center text-xl leading-snug md:max-w-80 md:text-2xl">
            {annotation}
          </span>
        )
      }
    </div>
  </div>
</footer>
